{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "petloxtus",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"PUBLIC_LEAD_WEBHOOK_URL": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "petloxtus-emdash"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "petloxtus-media"
		}
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }]
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" }
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"]
	}
}
