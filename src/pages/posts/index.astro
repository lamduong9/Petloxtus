---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import HeadMeta from "../../components/HeadMeta.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import QuoteModal from "../../components/QuoteModal.astro";
import { resolveWebhookUrl } from "../../data/catalog";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
  entries: posts,
  cacheHint,
  nextCursor,
} = await getEmDashCollection("posts", {
  orderBy: { published_at: "desc" },
  limit: 20,
  cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
  "posts",
  posts.map((p) => p.data.id),
  "tag",
);

const FALLBACK_COVERS = [
  "/assets/factory-craft.webp",
  "/assets/oem-packaging.webp",
  "/assets/qc-inspection.webp",
  "/assets/hero-showcase.webp",
];

const postsWithMeta = posts.map((post, idx) => ({
  post,
  tags: tagsByEntry.get(post.data.id) ?? [],
  readingTime: getReadingTime(post.data.content),
  publishedDate: post.data.publishedAt ? formatDate(post.data.publishedAt, "short") : null,
  fallbackImage: FALLBACK_COVERS[idx % FALLBACK_COVERS.length],
}));

const webhookUrl = resolveWebhookUrl(Astro.locals);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <HeadMeta
      title="Sourcing Journal & Manufacturing Insights — Petloxtus | petloxtus.com"
      description="B2B insights from Petloxtus Vietnam factory: sustainable pet materials, OEM & ODM custom packaging, compliance audits, and global pet product sourcing guides."
    />
  </head>
  <body data-webhook-url={webhookUrl}>
    <div id="site-wrapper">
      <SiteHeader active="journal" />

      <main>
        <section class="products-hero">
          <div class="container products-hero__inner">
            <div>
              <span class="eyebrow">Petloxtus Sourcing Journal</span>
              <h1>Manufacturing &amp; Export Insights</h1>
              <p>
                Practical guides from our Vietnam factory and 20-member sourcing desk on FSC timber, natural fibers, OEM packaging, quality audits, and global retail compliance.
              </p>
              <div style="margin-top: 26px; display: flex; gap: 14px; flex-wrap: wrap;">
                <button
                  type="button"
                  class="btn btn--brand js-open-quote"
                  data-product="Custom OEM / ODM Project & NDA"
                  data-i18n="btn_quote"
                >
                  Request a Quote
                </button>
                <a href="/products" class="btn btn--outline-light">
                  Explore 71+ Products
                </a>
              </div>
            </div>
          </div>
        </section>

        <section class="section section--cream">
          <div class="container">
            {postsWithMeta.length === 0 ? (
              <div class="text-center" style="padding: 48px 20px;">
                <h2 class="section-title">No articles published yet</h2>
                <p class="section-subtitle">
                  Publish your first article in EmDash Admin and it will appear here automatically.
                </p>
              </div>
            ) : (
              <div class="journal-grid">
                {postsWithMeta.map(({ post, tags, readingTime, publishedDate, fallbackImage }) => (
                  <article class="journal-card">
                    <a href={`/posts/${post.id}`} class="journal-card__media" aria-label={post.data.title}>
                      {post.data.featured_image ? (
                        <Image
                          image={post.data.featured_image}
                          sizes="(min-width: 1024px) 380px, (min-width: 680px) 46vw, 94vw"
                        />
                      ) : (
                        <img src={fallbackImage} alt={post.data.title} />
                      )}
                    </a>
                    <div class="journal-card__body">
                      <div class="journal-card__meta">
                        {publishedDate && <span>{publishedDate}</span>}
                        <span>•</span>
                        <span>{readingTime} min read</span>
                      </div>
                      <h2 class="journal-card__title">
                        <a href={`/posts/${post.id}`}>{post.data.title}</a>
                      </h2>
                      {post.data.excerpt && (
                        <p class="journal-card__excerpt">{post.data.excerpt}</p>
                      )}
                      <div class="journal-card__footer">
                        <div class="journal-card__tags">
                          {tags.slice(0, 2).map((tag) => (
                            <span class="journal-tag">{tag.label}</span>
                          ))}
                        </div>
                        <a href={`/posts/${post.id}`} class="journal-card__read">
                          Read Article →
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            )}

            {(cursor || nextCursor) && (
              <div style="margin-top: 40px; display: flex; justify-content: center; gap: 14px;">
                {cursor && (
                  <a href="/posts" class="btn btn--outline">
                    ← Latest Articles
                  </a>
                )}
                {nextCursor && (
                  <a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`} class="btn btn--brand">
                    Older Articles →
                  </a>
                )}
              </div>
            )}
          </div>
        </section>
      </main>

      <SiteFooter />
    </div>

    <QuoteModal defaultProduct="Full B2B Factory Catalog & Price Sheet" />

    <script src="/i18n.js?v=20261124" is:inline></script>
    <script src="/script.js?v=20261124d" is:inline></script>
  </body>
</html>
